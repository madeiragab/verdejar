# Porta da API
PORT=3333
# Origem do front (CORS + cookie)
WEB_ORIGIN=http://localhost:5173
# Banco: SQLite no dev. Em produção use a URL do Postgres (Neon) e troque o provider no schema.prisma
DATABASE_URL="file:./dev.db"
# Gere valores longos e aleatórios em produção
JWT_ACCESS_SECRET=troque-isto-access
JWT_REFRESH_SECRET=troque-isto-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# true em produção (HTTPS)
COOKIE_SECURE=false
# URL pública da API (usada para montar o link das fotos salvas em disco)
PUBLIC_URL=http://localhost:3333
# Opcional: cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (se vazio, salva em ./uploads)
CLOUDINARY_URL=
# Intervalo da coleta de notícias (minutos). 0 desliga.
NEWS_REFRESH_MINUTES=60
# Usuário admin criado pelo seed
SEED_ADMIN_EMAIL=admin@verdejar.app
SEED_ADMIN_PASSWORD=verdejar123
