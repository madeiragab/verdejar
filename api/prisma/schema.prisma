// Em produção troque para "postgresql" (veja docs/06-deploy-gratuito.md)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("USER") // USER | MODERATOR | ADMIN
  createdAt     DateTime       @default(now())
  plants        Plant[]        @relation("contributor")
  reviewed      Plant[]        @relation("reviewer")
  refreshTokens RefreshToken[]
}

model Plant {
  id              String    @id @default(cuid())
  scientificName  String
  popularNames    String // separados por vírgula
  family          String?
  description     String?
  biome           String
  climate         String?
  light           String
  water           String
  medicinalUse    String?
  toxicityLevel   String    @default("DESCONHECIDA")
  toxicityNotes   String?
  curiosities     String?
  photoUrl        String?
  photoCredit     String?
  state           String
  municipality    String
  latitude        Float?
  longitude       Float?
  source          String
  sourceUrl       String?
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote      String?
  showContributor Boolean   @default(false)
  contributorId   String?
  contributor     User?     @relation("contributor", fields: [contributorId], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      User?     @relation("reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, state, municipality])
  @@index([scientificName])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model NewsItem {
  id          String   @id @default(cuid())
  title       String
  link        String   @unique
  summary     String?
  imageUrl    String?
  sourceName  String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}
