# ── Servidor ──
PORT=3333
# Origem(ns) do frontend, separadas por vírgula (CORS + cookie)
WEB_ORIGIN=http://localhost:5173
# URL pública da API (usada no link das fotos salvas em disco)
PUBLIC_URL=http://localhost:3333

# ── Banco (PostgreSQL) ──
# Dev: `npm run db:start` sobe um Postgres local nessa URL (ou use o docker-compose da raiz)
# Produção: URL do Neon/Supabase/Render
DATABASE_URL="postgresql://verdejar:verdejar@localhost:5433/verdejar?schema=public"

# ── Autenticação (gere valores longos e aleatórios em produção) ──
JWT_ACCESS_SECRET=troque-isto-access
JWT_REFRESH_SECRET=troque-isto-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# true em produção (HTTPS, front e API em domínios diferentes)
COOKIE_SECURE=false

# ── Fotos ──
# Fotos ficam no banco por padrão (STORAGE_DRIVER=disk salva em ./uploads)
# Opcional: cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (tem prioridade sobre o banco)
CLOUDINARY_URL=

# ── Notícias ──
# Intervalo da coleta em minutos (0 desliga)
NEWS_REFRESH_MINUTES=60

# ── Seed ──
SEED_ADMIN_EMAIL=admin@verdejar.app
SEED_ADMIN_PASSWORD=verdejar123
